[["Map",1,2,9,10],"meta::meta",["Map",3,4,5,6,7,8],"astro-version","5.13.2","content-config-digest","36b35960babc62f1","astro-config-digest","{\"root\":{},\"srcDir\":{},\"publicDir\":{},\"outDir\":{},\"cacheDir\":{},\"site\":\"https://starlight.catppuccin.com\",\"compressHTML\":true,\"base\":\"/\",\"trailingSlash\":\"ignore\",\"output\":\"static\",\"scopedStyleStrategy\":\"where\",\"build\":{\"format\":\"directory\",\"client\":{},\"server\":{},\"assets\":\"_astro\",\"serverEntry\":\"entry.mjs\",\"redirects\":true,\"inlineStylesheets\":\"auto\",\"concurrency\":1},\"server\":{\"open\":false,\"host\":false,\"port\":4321,\"streaming\":true,\"allowedHosts\":[]},\"redirects\":{},\"image\":{\"endpoint\":{\"route\":\"/_image\"},\"service\":{\"entrypoint\":\"astro/assets/services/sharp\",\"config\":{}},\"domains\":[],\"remotePatterns\":[],\"responsiveStyles\":false},\"devToolbar\":{\"enabled\":true},\"markdown\":{\"syntaxHighlight\":false,\"shikiConfig\":{\"langs\":[],\"langAlias\":{},\"theme\":\"github-dark\",\"themes\":{},\"wrap\":false,\"transformers\":[]},\"remarkPlugins\":[null,null,null],\"rehypePlugins\":[null,[null,{\"experimentalHeadingIdCompat\":false}],null,[null,{\"themes\":[\"catppuccin-mocha\",\"catppuccin-latte\"],\"defaultLocale\":\"en\",\"cascadeLayer\":\"starlight.components\",\"styleOverrides\":{\"borderRadius\":\"0px\",\"borderWidth\":\"1px\",\"codePaddingBlock\":\"0.75rem\",\"codePaddingInline\":\"1rem\",\"codeFontFamily\":\"var(--__sl-font-mono)\",\"codeFontSize\":\"var(--sl-text-code)\",\"codeLineHeight\":\"var(--sl-line-height)\",\"uiFontFamily\":\"var(--__sl-font)\",\"textMarkers\":{\"lineDiffIndicatorMarginLeft\":\"0.25rem\",\"defaultChroma\":\"45\",\"backgroundOpacity\":\"60%\",\"insBackground\":\"color-mix(in oklab, var(--sl-color-green-high) 25%, var(--sl-color-gray-6));\",\"insBorderColor\":\"var(--sl-color-gray-5)\",\"delBackground\":\"color-mix(in oklab, var(--sl-color-red-high) 25%, var(--sl-color-gray-6));\",\"delBorderColor\":\"var(--sl-color-gray-5)\"},\"codeBackground\":\"var(--sl-color-gray-6)\"},\"plugins\":[{\"name\":\"Starlight Plugin\",\"hooks\":{}},{\"name\":\"astro-expressive-code\",\"hooks\":{}}]}]],\"remarkRehype\":{},\"gfm\":true,\"smartypants\":true},\"security\":{\"checkOrigin\":true},\"env\":{\"schema\":{},\"validateSecrets\":false},\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"headingIdCompat\":false,\"preserveScriptOrder\":false,\"liveContentCollections\":false,\"csp\":false,\"staticImportMetaEnv\":false,\"chromeDevtoolsWorkspace\":false},\"legacy\":{\"collections\":false},\"prefetch\":{\"prefetchAll\":true},\"i18n\":{\"defaultLocale\":\"en\",\"locales\":[\"en\"],\"routing\":{\"prefixDefaultLocale\":false,\"redirectToDefaultLocale\":false,\"fallbackType\":\"redirect\"}}}","docs",["Map",11,12,24,25,34,35,57,58,67,68,77,78,87,88,98,99,108,109,118,119,128,129,138,139,149,150,159,160,170,171,181,182,191,192],"enter/enter",{"id":11,"data":13,"body":21,"filePath":22,"digest":23,"deferredRender":15},{"title":14,"description":14,"editUrl":15,"head":16,"template":17,"sidebar":18,"pagefind":15,"draft":19},"进入服务器",true,[],"doc",{"hidden":19,"attrs":20},false,{},"- 各节点分摊了服务器有限的带宽，所以为避免节点拥堵，也为了你更好的游戏体验，请尽可能选择就近节点。\r\n\r\n生存服节点：\r\n- 山东节点：sd.chspif.xyz\r\n- 浙江节点: hz.chspif.xyz\r\n- 广东节点: gd.chspif.xyz\r\n- 北美节点：usa.chspif.xyz\r\n\r\n创造服节点：\r\n- 山东节点: sd.void.chspif.xyz\r\n- 浙江节点: zj.void.chspif.xyz\r\n\r\n镜像服节点(按需开放)：\r\n- 山东节点: sd.mirror.chspif.xyz\r\n\r\n小游戏服节点：\r\n- 山东节点: sd.game.chspif.xyz\r\n- 浙江节点: zj.game.chspif.xyz\r\n- 广东节点: gd.game.chspif.xyz\r\n\r\n活动服节点(不定期开放):\r\n- 山东节点: sd.party.chspif.xyz\r\n- 浙江节点: zj.party.chspif.xyz","src/content/docs/enter/enter.mdx","324abe4de9e43622","enter/whitelist",{"id":24,"data":26,"body":31,"filePath":32,"digest":33,"deferredRender":15},{"title":27,"description":27,"editUrl":15,"head":28,"template":17,"sidebar":29,"pagefind":15,"draft":19},"白名单绑定",[],{"hidden":19,"attrs":30},{},"- 在qq群内发送消息\"  #绑定 你的正版JavaID   \"， 群内会有机器人帮你自动完成绑定\r\n\r\n- 如果你不小心绑错了ID，请使用“#绑定 解绑 你的QQ号”解除绑定后再重新绑定。","src/content/docs/enter/whitelist.mdx","f3c4b12a60049804","index",{"id":34,"data":36,"filePath":55,"digest":56,"deferredRender":15},{"title":37,"description":38,"editUrl":15,"head":39,"template":40,"hero":41,"sidebar":53,"pagefind":15,"draft":19},"资料导航","请确保你在进入服务器前已经完整阅读以下内容",[],"splash",{"tagline":38,"actions":42},[43,47,50],{"text":44,"link":45,"variant":46},"新人wiki","/rules/communication/","primary",{"text":48,"link":49,"variant":46},"文件下载站","https://download.chspif.space/",{"text":51,"link":52,"variant":46},"网页地图","http://114.55.34.6:8100/",{"hidden":19,"attrs":54},{},"src/content/docs/index.mdx","e5a1309b9736f181","rules/communication",{"id":57,"data":59,"body":64,"filePath":65,"digest":66,"deferredRender":15},{"title":60,"description":60,"editUrl":15,"head":61,"template":17,"sidebar":62,"pagefind":15,"draft":19},"关于如何交流",[],{"hidden":19,"attrs":63},{},"⚠ 基本的素质是本服的底线，请仔细阅读本页面。\r\n\r\n\r\n- 请保持基本的素质和良好的态度，友好与其他玩家交流，保持对其他玩家的尊重。在提出问题前，请确保你的问题实属个人无法解决，不要浪费大家的时间和精力。如果你愿意，欢迎你花一点时间阅读[\"提问的智慧\"](https://github.com/ryanhanwu/How-To-Ask-Questions-The-Smart-Way/blob/main/README-zh_CN.md)\r\n- 禁止在任何公共交流频道刷屏，禁止转发违法违规、有悖道德、恶趣味、烂梗等令人反感的内容。交流方式请合理，不要充满戾气。","src/content/docs/rules/communication.mdx","57536828a1ec7de0","enter/prepare",{"id":67,"data":69,"body":74,"filePath":75,"digest":76,"deferredRender":15},{"title":70,"description":70,"editUrl":15,"head":71,"template":17,"sidebar":72,"pagefind":15,"draft":19},"准备工作",[],{"hidden":19,"attrs":73},{},"- 我们更推荐你使用语音来和其他玩家进行交流，有问题请尽量前往我们oopz提问，大家都很友好的）。\r\n\r\n服务器版本为1.21.11，进入服务器前，需要你强制安装某些mod；同时我们也为你打包好了一些提供便捷的模组。\r\n\r\n- 点击[这里](https://download.chspif.space/)进入下载站，按需选择你的模组包。","src/content/docs/enter/prepare.mdx","adc955ce3083192b","rules/time",{"id":77,"data":79,"body":84,"filePath":85,"digest":86,"deferredRender":15},{"title":80,"description":80,"editUrl":15,"head":81,"template":17,"sidebar":82,"pagefind":15,"draft":19},"关于活跃度",[],{"hidden":19,"attrs":83},{},"为保证整体活跃度和玩家体验，我们会不定期清理服务器活跃度低的玩家，以下情况除外\r\n\r\n- 为服务器做出过巨大贡献的玩家\r\n- 服务器活跃度低，但交流平台活跃度高的玩家\r\n- 管理和维护人员\r\n- 其他特殊人员","src/content/docs/rules/time.mdx","5a33aff99aea49ee","rules/violations",{"id":87,"data":89,"body":95,"filePath":96,"digest":97,"deferredRender":15},{"title":90,"description":91,"editUrl":15,"head":92,"template":17,"sidebar":93,"pagefind":15,"draft":19},"关于违规行为","服务器违规行为的定义和处理",[],{"hidden":19,"attrs":94},{},"服务器所有规则具有普遍性、常规性、概括性。\r\n\r\n如果不确定某种行为是否可能造成违规，请在主群内咨询\r\n\r\n包含但不限于以下行为属于违反服务器规定\r\n\r\n- 任何违反中华人民共和国法律、道德的行为。\r\n- 各种意义上的言论不当，包括不限于涉黄涉暴、政治敏感、宗教、刷屏、攻击、散播谣言、广告、泄露个人信息等。\r\n- 随意破坏其他玩家的劳动成功，以任何形式妨碍其他玩家的正常游戏体验。\r\n- 非必要情况下使用投影打印机功能、任何外挂类、漏洞类功能，包括不限于飞行、无敌、变速、修改交互距离、刷取物品、大量发包等。\r\n- 使用/建造机器不考虑可能会导致服务器卡崩的行为。\r\n- 在既定闯祸的前提下隐瞒不报。\r\n- 无意义破坏美观的行为，如擎天柱。\r\n- 向外泄露服务器内部资料/在其他服务器相关页面宣传本服。\r\n- 在服务器各类社区内宣传其他服务器/社区。","src/content/docs/rules/violations.mdx","d4b1e0bcaeb20833","features/server-commands",{"id":98,"data":100,"body":105,"filePath":106,"digest":107,"deferredRender":15},{"title":101,"description":101,"editUrl":15,"head":102,"template":17,"sidebar":103,"pagefind":15,"draft":19},"服务器指令",[],{"hidden":19,"attrs":104},{},"## 常用指令  \r\n\r\n`/getPlayerSkull \u003C玩家> \u003C数量>`  \r\n　　　获取某个玩家的头颅   \r\n\r\n`/seed`  \r\n　　　获取服务器种子  \r\n\r\n`/killMe`  \r\n　　　自杀   \r\n\r\n`/xpTransfer \u003C输出玩家> \u003C输入玩家> \u003C单位> \u003C数量>`    \r\n　　　转移玩家经验（仅限假人与自己）   \r\n    \r\n`/trigger smallfix`   \r\n　　　进入/退出检修模式（缩小玩家体积）  \r\n\r\n`/player`等carpet指令   \r\n　　　自行查阅carpet指令文档   \r\n\r\n`!s` 或 `!!spec`   \r\n　　　高级版灵魂出窍（切旁观，切回生存传送回原位置）   \r\n\r\n`!d`或`!!st`   \r\n　　　根据当前坐标在地狱和主世界间快速切换，自身必须是非生存模式且处于地狱与主世界间的任一维度   \r\n\r\n`!!st id \u003C玩家>`   \r\n　　　传送到某个玩家，自身必须是非生存模式    \r\n\r\n`!!st \u003Cx> \u003Cy> \u003Cz>`   \r\n　　　传送到自身所在维度的指定坐标,自身必须是非生存模式   \r\n    \r\n`!!st \u003Cx> \u003Cy> \u003Cz> in \u003C维度:0主世界,-1地狱,1末地>`   \r\n　　　传送到某个维度的指定坐标,自身必须是非生存模式   \r\n\r\n`!!wp list [\u003Cpage>]`   \r\n　　　列出所有的公共坐标点，page不填则默认为1\r\n\r\n`/getsavesize`   \r\n　　　获取服务器存档的大小   \r\n\r\n`!!pb make \u003C注释>`   \r\n　　　进行一次主动备份   \r\n\r\n`/kick \u003C玩家> [\u003C原因>]`  \r\n　　　踢出某个玩家     \r\n\r\n## 更多参考\r\n\r\nhttps://mcdreforged.com/zh-CN/plugin/where2go/readme","src/content/docs/features/server-commands.mdx","fbfea38b5ec66e0b","rules/ingame",{"id":108,"data":110,"body":115,"filePath":116,"digest":117,"deferredRender":15},{"title":111,"description":111,"editUrl":15,"head":112,"template":17,"sidebar":113,"pagefind":15,"draft":19},"关于游戏内",[],{"hidden":19,"attrs":114},{},"- 请在游戏内尊重玩家及其劳动成果。\r\n- 作为使用者，不要随便破坏其他玩家的建筑/机器。在你想找寻某种机器或使用某种不会的机器时，请务必向其他玩家交流和咨询。同时你也可以搭配机器地图食用。如果你不小心破坏了其他玩家的建筑/机器，请务必修复。在已经导致不可修复的错误的情况下，请务必向群内承认并寻求帮助。\r\n- 作为建造者，设计机器请考虑指引问题和优化问题，帮助其他玩家快速了解使用方法，请勿过度消耗服务器硬件资源。对于已经存在相同功能的机器，不再允许重复建造。\r\n- 如果你需要\r\n    - 消耗大量某种库存\r\n    - 开机某种大型机器\r\n    - 建造大体量建筑\r\n    - 建造服内不存在的机器或更高产能的机器\r\n    \r\n    请提前打招呼，避免出现\r\n    - 过度消耗服务器资源性能\r\n    - 形成烂尾建筑\r\n    - 出现重复造轮子的现象\r\n- 请已经熟悉服务器的玩家在允许的情况下，尽可能为新玩家提供引导和帮助。","src/content/docs/rules/ingame.mdx","f41bc829bf3c9ab6","rules/other",{"id":118,"data":120,"body":125,"filePath":126,"digest":127,"deferredRender":15},{"title":121,"description":121,"editUrl":15,"head":122,"template":17,"sidebar":123,"pagefind":15,"draft":19},"其他",[],{"hidden":19,"attrs":124},{},"- 如果你想向某人推荐我们的服务器，请让他正常填写审核表单。\r\n- 请勿在任何其他服务器或不适场合内宣传我们服务器。\r\n- 请勿在任何场合以服务器的任何身份或名义，参与任何表态、站队等任何以个人身份代表服务器名义的行为。\r\n- 服务器目前不接受任何形式上的赞助。","src/content/docs/rules/other.mdx","c70aadd55ed9ab6a","features/server-recipes",{"id":128,"data":130,"body":135,"filePath":136,"digest":137,"deferredRender":15},{"title":131,"description":131,"editUrl":15,"head":132,"template":17,"sidebar":133,"pagefind":15,"draft":19},"服务器特殊内容",[],{"hidden":19,"attrs":134},{},"在不过于影响原版机制的情况下，我们修改了一些与原版不符的内容：   \r\n\r\n- 末影箱是原版的两倍大小   \r\n- 服务器有一些特殊成就，用于平时发放周边等   \r\n- 对于潜影盒、末影箱等，你可以直接拿在手中右键打开   \r\n- 你可以合成鞘翅\r\n    ![图片1](https://img.cdn1.vip/i/6986efa51fc23_1770450853.png)   \r\n- 你可以升级自己的下界合金锄，使它变得易于挖掘玻璃方块、玻璃板与萤石等透明方块\r\n    ![图片1](https://img.cdn1.vip/i/6986efe0a42d3_1770450912.webp)","src/content/docs/features/server-recipes.mdx","adc73998876b0049","other/carpet-settings",{"id":138,"data":140,"body":146,"filePath":147,"digest":148,"deferredRender":15},{"title":141,"description":142,"editUrl":15,"head":143,"template":17,"sidebar":144,"pagefind":15,"draft":19},"carpet配置","carpet相关设置的图片展示",[],{"hidden":19,"attrs":145},{},"![图片1](https://img.cdn1.vip/i/697a3980efa73_1769617792.webp)\r\n\r\n![图片1](https://img.cdn1.vip/i/697a39e0b9242_1769617888.webp)","src/content/docs/other/carpet-settings.mdx","75d5ece6f2de1be3","other/mod",{"id":149,"data":151,"body":156,"filePath":157,"digest":158,"deferredRender":15},{"title":152,"description":152,"editUrl":15,"head":153,"template":17,"sidebar":154,"pagefind":15,"draft":19},"fabric mod 与 mcdr 插件展示",[],{"hidden":19,"attrs":155},{},"## fabric mods\r\n![fabric mods](https://img.cdn1.vip/i/69ffef5aafd74_1778380634.webp)\r\n\r\n## mcdr 插件\r\n![mcdr plugins](https://img.cdn1.vip/i/69ffef917c769_1778380689.webp)","src/content/docs/other/mod.mdx","7f7c2280ecc19cf8","other/qa",{"id":159,"data":161,"body":167,"filePath":168,"digest":169,"deferredRender":15},{"title":162,"description":163,"editUrl":15,"head":164,"template":17,"sidebar":165,"pagefind":15,"draft":19},"Q&A","常见问题解答",[],{"hidden":19,"attrs":166},{},"- 服务器配置？\r\n\r\n    13900ks + 32G DDR4 + 50M上行带宽\r\n\r\n- 服务端配置？\r\n\r\n    fabric/部分优化插件和数据包/视距10\r\n    \r\n- 服务器备份策略？\r\n\r\n    服务器每小时会进行一次自动备份，热保留最近三十天天的所有备份，并会不定期进行冷备份。","src/content/docs/other/qa.mdx","f62038f9c7221a9f","rules/xiabb",{"id":170,"data":172,"body":178,"filePath":179,"digest":180,"deferredRender":15},{"title":173,"description":174,"editUrl":15,"head":175,"template":17,"sidebar":176,"pagefind":15,"draft":19},"写在前面的话","阿爸阿爸",[],{"hidden":19,"attrs":177},{},"md我还不知道怎么写","src/content/docs/rules/xiabb.mdx","f413fbbeb1ae4516","shared-server/server-config",{"id":181,"data":183,"body":188,"filePath":189,"digest":190,"deferredRender":15},{"title":184,"description":184,"editUrl":15,"head":185,"template":17,"sidebar":186,"pagefind":15,"draft":19},"共享服务器配置",[],{"hidden":19,"attrs":187},{},"- cpu为13900ks，被分配到共6个逻辑核心和16g内存。\r\n- 上下行带宽分别被限制到20m/100m。\r\n- 公网IP被解析到 www.chspif.website 上，对公网共开放3390、1914、1915、1916四个端口。其中，3390端口被远程桌面所占据。","src/content/docs/shared-server/server-config.mdx","9cbd3c399919dbf8","shared-server/precautions",{"id":191,"data":193,"body":199,"filePath":200,"digest":201,"deferredRender":15},{"title":194,"description":195,"editUrl":15,"head":196,"template":17,"sidebar":197,"pagefind":15,"draft":19},"注意事项","共享服务器注意事项",[],{"hidden":19,"attrs":198},{},"- 重要数据请自行备份，服务器不对数据丢失负责\n- 合理使用服务器资源，避免影响其他用户\n- 发现异常或违规行为请及时反馈\n- 以下行为在服务器上被严格禁止：\n\n    搭建各类网站、Web服务\n\n    任何形式的加密货币挖矿\n\n    搭建钓鱼网站或进行钓鱼攻击\n\n    进行金融交易、洗钱等违法活动\n\n    搭建或使用代理翻墙服务\n\n    对服务器或外部网络进行端口扫描\n\n    使用服务器作为代理发送网络请求\n\n    长时间占用服务器资源，影响他人使用\n\n    传播违法、色情、暴力等不良信息\n\n    攻击、入侵他人账户或服务器系统\n\n    利用服务器进行网络攻击\n    \n    存储或传播恶意软件、病毒、木马等\n\n    滥用服务器资源进行爬虫、刷量等行为\n\n    任何违反国家法律法规的行为","src/content/docs/shared-server/precautions.mdx","f8e9122fc56dccdd"]