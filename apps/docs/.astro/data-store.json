[["Map",1,2,9,10],"meta::meta",["Map",3,4,5,6,7,8],"astro-version","5.13.2","content-config-digest","36b35960babc62f1","astro-config-digest","{\"root\":{},\"srcDir\":{},\"publicDir\":{},\"outDir\":{},\"cacheDir\":{},\"site\":\"https://starlight.catppuccin.com\",\"compressHTML\":true,\"base\":\"/\",\"trailingSlash\":\"ignore\",\"output\":\"static\",\"scopedStyleStrategy\":\"where\",\"build\":{\"format\":\"directory\",\"client\":{},\"server\":{},\"assets\":\"_astro\",\"serverEntry\":\"entry.mjs\",\"redirects\":true,\"inlineStylesheets\":\"auto\",\"concurrency\":1},\"server\":{\"open\":false,\"host\":false,\"port\":4321,\"streaming\":true,\"allowedHosts\":[]},\"redirects\":{},\"image\":{\"endpoint\":{\"route\":\"/_image\"},\"service\":{\"entrypoint\":\"astro/assets/services/sharp\",\"config\":{}},\"domains\":[],\"remotePatterns\":[],\"responsiveStyles\":false},\"devToolbar\":{\"enabled\":true},\"markdown\":{\"syntaxHighlight\":false,\"shikiConfig\":{\"langs\":[],\"langAlias\":{},\"theme\":\"github-dark\",\"themes\":{},\"wrap\":false,\"transformers\":[]},\"remarkPlugins\":[null,null,null],\"rehypePlugins\":[null,[null,{\"experimentalHeadingIdCompat\":false}],null,[null,{\"themes\":[\"catppuccin-mocha\",\"catppuccin-latte\"],\"defaultLocale\":\"en\",\"cascadeLayer\":\"starlight.components\",\"styleOverrides\":{\"borderRadius\":\"0px\",\"borderWidth\":\"1px\",\"codePaddingBlock\":\"0.75rem\",\"codePaddingInline\":\"1rem\",\"codeFontFamily\":\"var(--__sl-font-mono)\",\"codeFontSize\":\"var(--sl-text-code)\",\"codeLineHeight\":\"var(--sl-line-height)\",\"uiFontFamily\":\"var(--__sl-font)\",\"textMarkers\":{\"lineDiffIndicatorMarginLeft\":\"0.25rem\",\"defaultChroma\":\"45\",\"backgroundOpacity\":\"60%\",\"insBackground\":\"color-mix(in oklab, var(--sl-color-green-high) 25%, var(--sl-color-gray-6));\",\"insBorderColor\":\"var(--sl-color-gray-5)\",\"delBackground\":\"color-mix(in oklab, var(--sl-color-red-high) 25%, var(--sl-color-gray-6));\",\"delBorderColor\":\"var(--sl-color-gray-5)\"},\"codeBackground\":\"var(--sl-color-gray-6)\"},\"plugins\":[{\"name\":\"Starlight Plugin\",\"hooks\":{}},{\"name\":\"astro-expressive-code\",\"hooks\":{}}]}]],\"remarkRehype\":{},\"gfm\":true,\"smartypants\":true},\"security\":{\"checkOrigin\":true},\"env\":{\"schema\":{},\"validateSecrets\":false},\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"headingIdCompat\":false,\"preserveScriptOrder\":false,\"liveContentCollections\":false,\"csp\":false,\"staticImportMetaEnv\":false,\"chromeDevtoolsWorkspace\":false},\"legacy\":{\"collections\":false},\"prefetch\":{\"prefetchAll\":true},\"i18n\":{\"defaultLocale\":\"en\",\"locales\":[\"en\"],\"routing\":{\"prefixDefaultLocale\":false,\"redirectToDefaultLocale\":false,\"fallbackType\":\"redirect\"}}}","docs",["Map",11,12,36,37,47,48,57,58,67,68,77,78,88,89,99,100,110,111,121,122,131,132,141,142,151,152,161,162],"index",{"id":11,"data":13,"filePath":34,"digest":35,"deferredRender":16},{"title":14,"description":15,"editUrl":16,"head":17,"template":18,"hero":19,"sidebar":31,"pagefind":16,"draft":32},"资料导航","请确保你在进入服务器前已经完整阅读以下内容",true,[],"splash",{"tagline":15,"actions":20},[21,25,28],{"text":22,"link":23,"variant":24},"新人wiki","/rules/communication/","primary",{"text":26,"link":27,"variant":24},"机器坐标","https://map.chspif.space",{"text":29,"link":30,"variant":24},"网页地图","http://114.55.34.6:8100/",{"hidden":32,"attrs":33},false,{},"src/content/docs/index.mdx","6239820479900958","rules/ingame",{"id":36,"data":38,"body":44,"filePath":45,"digest":46,"deferredRender":16},{"title":39,"description":39,"editUrl":16,"head":40,"template":41,"sidebar":42,"pagefind":16,"draft":32},"关于游戏内",[],"doc",{"hidden":32,"attrs":43},{},"- 请在游戏内尊重玩家及其劳动成果。\r\n- 作为使用者，不要随便破坏其他玩家的建筑/机器。在你想找寻某种机器或使用某种不会的机器时，请务必向其他玩家交流和咨询。同时你也可以搭配机器地图食用。如果你不小心破坏了其他玩家的建筑/机器，请务必修复。在已经导致不可修复的错误的情况下，请务必向群内承认并寻求帮助。\r\n- 作为建造者，设计机器请考虑指引问题和优化问题，帮助其他玩家快速了解使用方法，请勿过度消耗服务器硬件资源。对于已经存在相同功能的机器，不再允许重复建造。\r\n- 如果你需要\r\n    - 消耗大量某种库存\r\n    - 开机某种大型机器\r\n    - 建造大体量建筑\r\n    - 建造服内不存在的机器或更高产能的机器\r\n    \r\n    请提前打招呼，避免出现\r\n    - 过度消耗服务器资源性能\r\n    - 形成烂尾建筑\r\n    - 出现重复造轮子的现象\r\n- 请已经熟悉服务器的玩家在允许的情况下，尽可能为新玩家提供引导和帮助。","src/content/docs/rules/ingame.mdx","f41bc829bf3c9ab6","rules/time",{"id":47,"data":49,"body":54,"filePath":55,"digest":56,"deferredRender":16},{"title":50,"description":50,"editUrl":16,"head":51,"template":41,"sidebar":52,"pagefind":16,"draft":32},"关于活跃度",[],{"hidden":32,"attrs":53},{},"为保证整体活跃度和玩家体验，我们会不定期清理服务器活跃度低的玩家，以下情况除外\r\n\r\n- 为服务器做出过巨大贡献的玩家\r\n- 服务器活跃度低，但交流平台活跃度高的玩家\r\n- 管理和维护人员\r\n- 其他特殊人员","src/content/docs/rules/time.mdx","5a33aff99aea49ee","features/server-commands",{"id":57,"data":59,"body":64,"filePath":65,"digest":66,"deferredRender":16},{"title":60,"description":60,"editUrl":16,"head":61,"template":41,"sidebar":62,"pagefind":16,"draft":32},"服务器指令",[],{"hidden":32,"attrs":63},{},"## 常用指令  \r\n\r\n`/getPlayerSkull \u003C玩家> \u003C数量>`  \r\n　　　获取某个玩家的头颅   \r\n\r\n`/seed`  \r\n　　　获取服务器种子  \r\n\r\n`/killMe`  \r\n　　　自杀   \r\n\r\n`/xpTransfer \u003C输出玩家> \u003C输入玩家> \u003C单位> \u003C数量>`    \r\n　　　转移玩家经验（仅限假人与自己）   \r\n    \r\n`/trigger smallfix`   \r\n　　　进入/退出检修模式（缩小玩家体积）  \r\n\r\n`/player`等carpet指令   \r\n　　　自行查阅carpet指令文档   \r\n\r\n`!s` 或 `!!spec`   \r\n　　　高级版灵魂出窍（切旁观，切回生存传送回原位置）   \r\n\r\n`!d`或`!!st`   \r\n　　　根据当前坐标在地狱和主世界间快速切换，自身必须是非生存模式且处于地狱与主世界间的任一维度   \r\n\r\n`!!st id \u003C玩家>`   \r\n　　　传送到某个玩家，自身必须是非生存模式   \r\n\r\n`!!st id \u003C被传送玩家> \u003C目标玩家>`   \r\n　　　将被传送玩家传送到目标玩家，被传送玩家必须是非生存模式   \r\n\r\n`!!st \u003Cx> \u003Cy> \u003Cz>`   \r\n　　　传送到自身所在维度的指定坐标,自身必须是非生存模式   \r\n    \r\n`!!st \u003Cx> \u003Cy> \u003Cz> in \u003C维度:0主世界,-1地狱,1末地>`   \r\n　　　传送到某个维度的指定坐标,自身必须是非生存模式   \r\n\r\n## 如果你比较有社会责任感  \r\n\r\n`/getsavesize`   \r\n　　　获取服务器存档的大小   \r\n\r\n`/kick \u003C玩家> [\u003C原因>]`  \r\n　　　踢出某个玩家  \r\n\r\nhttps://spark.lucko.me/docs   \r\n　　　在服务器卡顿时向管理员建议文档中的内容","src/content/docs/features/server-commands.mdx","fde300194b7ec447","features/server-recipes",{"id":67,"data":69,"body":74,"filePath":75,"digest":76,"deferredRender":16},{"title":70,"description":70,"editUrl":16,"head":71,"template":41,"sidebar":72,"pagefind":16,"draft":32},"服务器特殊内容",[],{"hidden":32,"attrs":73},{},"在不过于影响原版机制的情况下，我们修改了一些与原版不符的内容：   \r\n\r\n- 末影箱是原版的两倍大小   \r\n- 服务器有一些特殊成就，用于平时发放周边等   \r\n- 对于潜影盒、末影箱等，你可以直接拿在手中右键打开   \r\n- 你可以合成鞘翅\r\n    ![图片1](https://img.cdn1.vip/i/6986efa51fc23_1770450853.png)   \r\n- 你可以升级自己的下界合金锄，使它变得易于挖掘玻璃方块、玻璃板与萤石等透明方块\r\n    ![图片1](https://img.cdn1.vip/i/6986efe0a42d3_1770450912.webp)","src/content/docs/features/server-recipes.mdx","adc73998876b0049","other/config",{"id":77,"data":79,"body":85,"filePath":86,"digest":87,"deferredRender":16},{"title":80,"description":81,"editUrl":16,"head":82,"template":41,"sidebar":83,"pagefind":16,"draft":32},"配置","服务器相关配置信息",[],{"hidden":32,"attrs":84},{},"软件配置\r\n- 每2小时进行一次数据备份，保留最近24次备份。\r\n- 服务端环境：Async-Fabric BlueMap Carpet-AMS-Addition Carpet-ORG-Addition Carpet-TIS-Addition Fabric-API Fabric-Carpet Fabric-Language-Kotlin Gugle-Carpet-Addition Jade Krypton Ledger Lithium QuickShulker Servux Spark Syncmatica TT20 VMP\r\n\r\n硬件配置\r\n- 9950X+32G内存\r\n- 30M上行带宽\r\n- BGP三线网络","src/content/docs/other/config.mdx","ef19b5b2bd94bb29","other/qa",{"id":88,"data":90,"body":96,"filePath":97,"digest":98,"deferredRender":16},{"title":91,"description":92,"editUrl":16,"head":93,"template":41,"sidebar":94,"pagefind":16,"draft":32},"Q&A","常见问题解答",[],{"hidden":32,"attrs":95},{},"To-do","src/content/docs/other/qa.mdx","eecdd8e9e3d18188","other/carpet-settings",{"id":99,"data":101,"body":107,"filePath":108,"digest":109,"deferredRender":16},{"title":102,"description":103,"editUrl":16,"head":104,"template":41,"sidebar":105,"pagefind":16,"draft":32},"carpet配置","carpet相关设置的图片展示",[],{"hidden":32,"attrs":106},{},"![图片1](https://img.cdn1.vip/i/697a3980efa73_1769617792.webp)\r\n\r\n![图片1](https://img.cdn1.vip/i/697a39e0b9242_1769617888.webp)","src/content/docs/other/carpet-settings.mdx","75d5ece6f2de1be3","rules/violations",{"id":110,"data":112,"body":118,"filePath":119,"digest":120,"deferredRender":16},{"title":113,"description":114,"editUrl":16,"head":115,"template":41,"sidebar":116,"pagefind":16,"draft":32},"关于违规行为","服务器违规行为的定义和处理",[],{"hidden":32,"attrs":117},{},"如果不确定某种行为是否可能造成违规，请在主群内咨询\r\n\r\n包含但不限于以下行为属于违反服务器规定\r\n\r\n- 各种意义上的言论不当，各种刷屏等影响玩家正常交流的行为。随意破坏其他玩家的劳动成功，以任何形式妨碍其他玩家的正常游戏体验\r\n- 无意义破坏美观的行为，如擎天柱\r\n- 使用投影打印机功能、任何外挂类、漏洞类功能\r\n- 在既定闯祸的前提下隐瞒不报\r\n- 向外泄露服务器内部资料/在其他服务器相关页面宣传本服\r\n- 使用/建造机器不考虑可能会导致服务器卡崩的行为","src/content/docs/rules/violations.mdx","d5f44121370fab86","enter/whitelist",{"id":121,"data":123,"body":128,"filePath":129,"digest":130,"deferredRender":16},{"title":124,"description":124,"editUrl":16,"head":125,"template":41,"sidebar":126,"pagefind":16,"draft":32},"白名单绑定",[],{"hidden":32,"attrs":127},{},"- 在qq群内发送\"  #绑定 你的JavaID   \" 群内会有机器人帮你自动完成绑定\r\n\r\n- 如果你不小心绑错了ID，请使用“#绑定 解绑 QQ号”解除绑定后再重新绑定。","src/content/docs/enter/whitelist.mdx","097efd09c31ac343","rules/communication",{"id":131,"data":133,"body":138,"filePath":139,"digest":140,"deferredRender":16},{"title":134,"description":134,"editUrl":16,"head":135,"template":41,"sidebar":136,"pagefind":16,"draft":32},"关于如何交流",[],{"hidden":32,"attrs":137},{},"⚠ 基本的素质是本服的底线，请仔细阅读本页面。\r\n\r\n\r\n- 请保持基本的素质和良好的态度，友好与其他玩家交流，保持对其他玩家的尊重。在提出问题前，请确保你的问题实属个人无法解决，不要浪费大家的时间和精力。如果你愿意，欢迎你花一点时间阅读[\"提问的智慧\"](https://github.com/ryanhanwu/How-To-Ask-Questions-The-Smart-Way/blob/main/README-zh_CN.md)\r\n- 禁止在任何公共交流频道刷屏，禁止转发违法违规、有悖道德、恶趣味、烂梗等令人反感的内容。交流方式请合理，不要充满戾气。","src/content/docs/rules/communication.mdx","57536828a1ec7de0","enter/prepare",{"id":141,"data":143,"body":148,"filePath":149,"digest":150,"deferredRender":16},{"title":144,"description":144,"editUrl":16,"head":145,"template":41,"sidebar":146,"pagefind":16,"draft":32},"准备工作",[],{"hidden":32,"attrs":147},{},"- 我们更推荐你使用语音来和其他玩家进行交流，我们提供了OOPZ公共频道https://oopz.cn/i/7XZYQD。\r\n- 群内目前共提供了三个服务器节点，请选择对你来说延迟较低的节点。\r\n\r\n服务器无需添加额外模组进入，但我们仍为你提供了一些优化材质和模组\r\n\r\n- 你可以点击[这里](https://wwase.lanzouu.com/iLe7X3i0jmle)下载生电模组套件（提示：会有键位冲突。建议在游戏键位界面解绑所有不需要的功能，并在techutils的设置中解绑R键）\r\n- 你可以点击[这里](https://chspifvideo.oss-cn-hangzhou.aliyuncs.com/%E6%9D%90%E8%B4%A8%E4%BC%98%E5%8C%96.7z)下载优化材质","src/content/docs/enter/prepare.mdx","79bfbd31c942b6ff","rules/other",{"id":151,"data":153,"body":158,"filePath":159,"digest":160,"deferredRender":16},{"title":154,"description":154,"editUrl":16,"head":155,"template":41,"sidebar":156,"pagefind":16,"draft":32},"其他",[],{"hidden":32,"attrs":157},{},"- 如果你想向某人推荐我们的服务器，请让他正常填写审核表单。\r\n- 请勿在任何其他服务器或不适场合内宣传我们服务器。","src/content/docs/rules/other.mdx","8986ea7e43a677e8","other/mod",{"id":161,"data":163,"body":168,"filePath":169,"digest":170,"deferredRender":16},{"title":164,"description":164,"editUrl":16,"head":165,"template":41,"sidebar":166,"pagefind":16,"draft":32},"fabric mod 与 mcdr 插件展示",[],{"hidden":32,"attrs":167},{},"## fabric mods\r\n![fabric mods](https://img.cdn1.vip/i/697a38624bdc4_1769617506.webp)\r\n\r\n## mcdr 插件\r\n![mcdr plugins](https://img.cdn1.vip/i/697e6ad48ea5d_1769892564.png)","src/content/docs/other/mod.mdx","fbc75ec7ddc71408"]