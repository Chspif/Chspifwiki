or-gray-5)\"},\"codeBackground\":\"var(--sl-color-gray-6)\"},\"plugins\":[{\"name\":\"Starlight Plugin\",\"hooks\":{}},{\"name\":\"astro-expressive-code\",\"hooks\":{}}]}]],\"remarkRehype\":{},\"gfm\":true,\"smartypants\":true},\"security\":{\"checkOrigin\":true},\"env\":{\"schema\":{},\"validateSecrets\":false},\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"headingIdCompat\":false,\"preserveScriptOrder\":false,\"liveContentCollections\":false,\"csp\":false,\"staticImportMetaEnv\":false,\"chromeDevtoolsWorkspace\":false},\"legacy\":{\"collections\":false},\"prefetch\":{\"prefetchAll\":true},\"i18n\":{\"defaultLocale\":\"en\",\"locales\":[\"en\"],\"routing\":{\"prefixDefaultLocale\":false,\"redirectToDefaultLocale\":false,\"fallbackType\":\"redirect\"}}}","docs",["Map",11,12,33,34,44,45,54,55,64,65,74,75,85,86,96,97,107,108,118,119,128,129,138,139,148,149,158,159],"index",{"id":11,"data":13,"filePath":31,"digest":32,"deferredRender":16},{"title":14,"description":15,"editUrl":16,"head":17,"template":18,"hero":19,"sidebar":28,"pagefind":16,"draft":29},"资料导航","请确保你在进入服务器前已经完整阅读以下内容",true,[],"splash",{"tagline":15,"actions":20},[21,25],{"text":22,"link":23,"variant":24},"新人wiki","/rules/communication/","primary",{"text":26,"link":27,"variant":24},"机器坐标","https://map.chspif.space",{"hidden":29,"attrs":30},false,{},"src/content/docs/index.mdx","14fa236fc3cd9a79","rules/ingame",{"id":33,"data":35,"body":41,"filePath":42,"digest":43,"deferredRender":16},{"title":36,"description":36,"editUrl":16,"head":37,"template":38,"sidebar":39,"pagefind":16,"draft":29},"关于游戏内",[],"doc",{"hidden":29,"attrs":40},{},"- 请在游戏内尊重玩家及其劳动成果。\r\n- 作为使用者，不要随便破坏其他玩家的建筑/机器。在你想找寻某种机器或使用某种不会的机器时，请务必向其他玩家交流和咨询。同时你也可以搭配机器地图食用。如果你不小心破坏了其他玩家的建筑/机器，请务必修复。在已经导致不可修复的错误的情况下，请务必向群内承认并寻求帮助。\r\n- 作为建造者，设计机器请考虑指引问题和优化问题，帮助其他玩家快速了解使用方法，请勿过度消耗服务器硬件资源。对于已经存在相同功能的机器，不再允许重复建造。\r\n- 如果你需要\r\n    - 消耗大量某种库存\r\n    - 开机某种大型机器\r\n    - 建造大体量建筑\r\n    - 建造服内不存在的机器或更高产能的机器\r\n    \r\n    请提前打招呼，避免出现\r\n    - 过度消耗服务器资源性能\r\n    - 形成烂尾建筑\r\n    - 出现重复造轮子的现象\r\n- 请已经熟悉服务器的玩家在允许的情况下，尽可能为新玩家提供引导和帮助。","src/content/docs/rules/ingame.mdx","f41bc829bf3c9ab6","rules/time",{"id":44,"data":46,"body":51,"filePath":52,"digest":53,"deferredRender":16},{"title":47,"description":47,"editUrl":16,"head":48,"template":38,"sidebar":49,"pagefind":16,"draft":29},"关于活跃度",[],{"hidden":29,"attrs":50},{},"为保证整体活跃度和玩家体验，我们会不定期清理服务器活跃度低的玩家，以下情况除外\r\n\r\n- 为服务器做出过巨大贡献的玩家\r\n- 服务器活跃度低，但交流平台活跃度高的玩家\r\n- 管理和维护人员\r\n- 其他特殊人员","src/content/docs/rules/time.mdx","5a33aff99aea49ee","features/server-commands",{"id":54,"data":56,"body":61,"filePath":62,"digest":63,"deferredRender":16},{"title":57,"description":57,"editUrl":16,"head":58,"template":38,"sidebar":59,"pagefind":16,"draft":29},"服务器指令",[],{"hidden":29,"attrs":60},{},"这里列举了作为普通玩家，你可以使用的一些指令\r\n\r\n- 使用\"  /getPlayerSkull 名字 数量   \"获取某个玩家的头颅\r\n- 使用\"    /getsavesize    \"获取服务器存档的大小\r\n- 使用\"    /kick   \"踢出某个玩家\r\n- 使用\"    /seed    \"获取服务器种子\r\n- 使用\"    /killMe    \"自杀\r\n- 使用\"    /xpTransfer   \"转移假人经验\r\n- 使用\"    /trigger smallfix   \"进入检修模式\r\n- 使用\"    !s   \"进入旁观者模式，再次使用会返回生存模式\r\n- 使用\"    !!st id 名字    \"在旁观模式下传送到某个玩家身边\r\n- 正常的一些carpet指令","src/content/docs/features/server-commands.mdx","9d50977c61487b38","features/server-recipes",{"id":64,"data":66,"body":71,"filePath":72,"digest":73,"deferredRender":16},{"title":67,"description":67,"editUrl":16,"head":68,"template":38,"sidebar":69,"pagefind":16,"draft":29},"服务器特殊内容",[],{"hidden":29,"attrs":70},{},"在不过于影响原版机制的情况下，我们修改了一些与原版不符的内容\r\n\r\n- 末影箱是原版的两倍大小。\r\n- 服务器有一些特殊成就，用于平时发放周边等。\r\n- 对于潜影盒、末影箱等，你可以直接拿在手中右键打开。\r\n- 你可以合成鞘翅\r\n![图片1](https://img.cdn1.vip/i/6907828fbae3d_1762099855.webp)","src/content/docs/features/server-recipes.mdx","fa05ad5817993ebc","other/config",{"id":74,"data":76,"body":82,"filePath":83,"digest":84,"deferredRender":16},{"title":77,"description":78,"editUrl":16,"head":79,"template":38,"sidebar":80,"pagefind":16,"draft":29},"配置","服务器相关配置信息",[],{"hidden":29,"attrs":81},{},"软件配置\r\n- 每2小时进行一次数据备份，保留最近24次备份。\r\n- 服务端环境：Async-Fabric BlueMap Carpet-AMS-Addition Carpet-ORG-Addition Carpet-TIS-Addition Fabric-API Fabric-Carpet Fabric-Language-Kotlin Gugle-Carpet-Addition Jade Krypton Ledger Lithium QuickShulker Servux Spark Syncmatica TT20 VMP\r\n\r\n硬件配置\r\n- 9950X+32G内存\r\n- 30M上行带宽\r\n- BGP三线网络","src/content/docs/other/config.mdx","ef19b5b2bd94bb29","other/qa",{"id":85,"data":87,"body":93,"filePath":94,"digest":95,"deferredRender":16},{"title":88,"description":89,"editUrl":16,"head":90,"template":38,"sidebar":91,"pagefind":16,"draft":29},"Q&A","常见问题解答",[],{"hidden":29,"attrs":92},{},"To-do","src/content/docs/other/qa.mdx","eecdd8e9e3d18188","other/carpet-settings",{"id":96,"data":98,"body":104,"filePath":105,"digest":106,"deferredRender":16},{"title":99,"description":100,"editUrl":16,"head":101,"template":38,"sidebar":102,"pagefind":16,"draft":29},"carpet配置","carpet相关设置的图片展示",[],{"hidden":29,"attrs":103},{},"![图片1](https://img.cdn1.vip/i/697a3980efa73_1769617792.webp)\r\n\r\n![图片1](https://img.cdn1.vip/i/697a39e0b9242_1769617888.webp)","src/content/docs/other/carpet-settings.mdx","eafe4d7e593d30ca","rules/violations",{"id":107,"data":109,"body":115,"filePath":116,"digest":117,"deferredRender":16},{"title":110,"description":111,"editUrl":16,"head":112,"template":38,"sidebar":113,"pagefind":16,"draft":29},"关于违规行为","服务器违规行为的定义和处理",[],{"hidden":29,"attrs":114},{},"如果不确定某种行为是否可能造成违规，请在主群内咨询\r\n\r\n包含但不限于以下行为属于违反服务器规定\r\n\r\n- 各种意义上的言论不当，各种刷屏等影响玩家正常交流的行为。随意破坏其他玩家的劳动成功，以任何形式妨碍其他玩家的正常游戏体验\r\n- 无意义破坏美观的行为，如擎天柱\r\n- 使用投影打印机功能、任何外挂类、漏洞类功能\r\n- 在既定闯祸的前提下隐瞒不报\r\n- 向外泄露服务器内部资料/在其他服务器相关页面宣传本服\r\n- 使用/建造机器不考虑可能会导致服务器卡崩的行为","src/content/docs/rules/violations.mdx","d5f44121370fab86","enter/whitelist",{"id":118,"data":120,"body":125,"filePath":126,"digest":127,"deferredRender":16},{"title":121,"description":121,"editUrl":16,"head":122,"template":38,"sidebar":123,"pagefind":16,"draft":29},"白名单绑定",[],{"hidden":29,"attrs":124},{},"- 在qq群内发送\"  #绑定 你的JavaID   \" 群内会有机器人帮你自动完成绑定\r\n\r\n- 如果你不小心绑错了ID，请使用“#绑定 解绑 QQ号”解除绑定后再重新绑定。","src/content/docs/enter/whitelist.mdx","097efd09c31ac343","rules/communication",{"id":128,"data":130,"body":135,"filePath":136,"digest":137,"deferredRender":16},{"title":131,"description":131,"editUrl":16,"head":132,"template":38,"sidebar":133,"pagefind":16,"draft":29},"关于如何交流",[],{"hidden":29,"attrs":134},{},"⚠ 基本的素质是本服的底线，请仔细阅读本页面。\r\n\r\n\r\n- 请保持基本的素质和良好的态度，友好与其他玩家交流，保持对其他玩家的尊重。在提出问题前，请确保你的问题实属个人无法解决，不要浪费大家的时间和精力。如果你愿意，欢迎你花一点时间阅读[\"提问的智慧\"](https://github.com/ryanhanwu/How-To-Ask-Questions-The-Smart-Way/blob/main/README-zh_CN.md)\r\n- 禁止在任何公共交流频道刷屏，禁止转发违法违规、有悖道德、恶趣味、烂梗等令人反感的内容。交流方式请合理，不要充满戾气。","src/content/docs/rules/communication.mdx","57536828a1ec7de0","enter/prepare",{"id":138,"data":140,"body":145,"filePath":146,"digest":147,"deferredRender":16},{"title":141,"description":141,"editUrl":16,"head":142,"template":38,"sidebar":143,"pagefind":16,"draft":29},"准备工作",[],{"hidden":29,"attrs":144},{},"- 我们更推荐你使用语音来和其他玩家进行交流，我们提供了OOPZ公共频道https://oopz.cn/i/7XZYQD。\r\n- 群内目前共提供了三个服务器节点，请选择对你来说延迟较低的节点。\r\n\r\n服务器无需添加额外模组进入，但我们仍为你提供了一些优化材质和模组\r\n\r\n- 你可以点击[这里](https://chspifvideo.oss-cn-hangzhou.aliyuncs.com/1.12.10_fabric_%E5%AE%A2%E6%88%B7%E7%AB%AF%E7%BA%A2%E7%9F%B3%E6%A8%A1%E7%BB%84_dp495.7z)下载优化模组\r\n- 你可以点击[这里](https://chspifvideo.oss-cn-hangzhou.aliyuncs.com/%E6%9D%90%E8%B4%A8%E4%BC%98%E5%8C%96.7z)下载优化材质","src/content/docs/enter/prepare.mdx","916fde8c0ed1ddce","rules/other",{"id":148,"data":150,"body":155,"filePath":156,"digest":157,"deferredRender":16},{"title":151,"description":151,"editUrl":16,"head":152,"template":38,"sidebar":153,"pagefind":16,"draft":29},"其他",[],{"hidden":29,"attrs":154},{},"- 如果你想向某人推荐我们的服务器，请让他正常填写审核表单。\r\n- 请勿在任何其他服务器或不适场合内宣传我们服务器。","src/content/docs/rules/other.mdx","8986ea7e43a677e8","other/mod",{"id":158,"data":160,"body":165,"filePath":166,"digest":167,"deferredRender":16},{"title":161,"description":100,"editUrl":16,"head":162,"template":38,"sidebar":163,"pagefind":16,"draft":29},"mod和carpet设置",[],{"hidden":29,"attrs":164},{},"Mod配置如图\r\n\r\n![图片1](https://img.cdn1.vip/i/697a38624bdc4_1769617506.webp)","src/content/docs/other/mod.mdx","56649b546d1b7580"]