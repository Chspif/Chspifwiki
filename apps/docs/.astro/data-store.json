or-gray-5)\"},\"codeBackground\":\"var(--sl-color-gray-6)\"},\"plugins\":[{\"name\":\"Starlight Plugin\",\"hooks\":{}},{\"name\":\"astro-expressive-code\",\"hooks\":{}}]}]],\"remarkRehype\":{},\"gfm\":true,\"smartypants\":true},\"security\":{\"checkOrigin\":true},\"env\":{\"schema\":{},\"validateSecrets\":false},\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"headingIdCompat\":false,\"preserveScriptOrder\":false,\"liveContentCollections\":false,\"csp\":false,\"staticImportMetaEnv\":false,\"chromeDevtoolsWorkspace\":false},\"legacy\":{\"collections\":false},\"prefetch\":{\"prefetchAll\":true},\"i18n\":{\"defaultLocale\":\"en\",\"locales\":[\"en\"],\"routing\":{\"prefixDefaultLocale\":false,\"redirectToDefaultLocale\":false,\"fallbackType\":\"redirect\"}}}","docs",["Map",11,12,38,39,49,50,59,60,69,70,79,80,89,90,100,101,111,112,122,123,133,134,144,145,154,155],"index",{"id":11,"data":13,"filePath":34,"assetImports":35,"digest":37,"deferredRender":16},{"title":14,"description":15,"editUrl":16,"head":17,"template":18,"hero":19,"sidebar":31,"pagefind":16,"draft":32},"资料导航","请确保你在进入服务器前已经完整阅读以下内容",true,[],"splash",{"tagline":15,"image":20,"actions":23},{"alt":21,"file":22},"","__ASTRO_IMAGE_../../assets/catppuccin.png",[24,28],{"text":25,"link":26,"variant":27},"新人wiki","/rules/server-rules","primary",{"text":29,"link":30,"variant":27},"机器坐标","https://map.chspif.space",{"hidden":32,"attrs":33},false,{},"src/content/docs/index.mdx",[36],"../../assets/catppuccin.png","202ee1324ee4f5c2","rules/server-rules",{"id":38,"data":40,"body":46,"filePath":47,"digest":48,"deferredRender":16},{"title":41,"description":41,"editUrl":16,"head":42,"template":43,"sidebar":44,"pagefind":16,"draft":32},"关于如何交流",[],"doc",{"hidden":32,"attrs":45},{},"⚠ 基本的素质是本服的底线，请仔细阅读本页面。\n\n\n- 请保持基本的素质和良好的态度，友好与其他玩家交流，保持对其他玩家的尊重。在提出问题前，请确保你的问题实属个人无法解决，不要浪费大家的时间和精力。\n- 禁止在群内刷屏，禁止转发违规、违法以及其他奇奇怪怪会令玩家感到不适的内容。交流方式请合理，不要充满戾气。\n- 禁止在任何服务器交流平台发送恶趣味、烂梗等令人反感的内容。\n- 对于游戏内问题，请尽可能选择OOPZ对应频道讨论、语音交流、私信等方式，不要在主群内大规模刷屏\n- 我们更推荐你使用语音来和其他玩家进行交流，我们提供了OOPZ公共频道https://oopz.cn/i/7XZYQD。\n- 如果你想向某人推荐我们的服务器，请让他正常填写审核表单。","src/content/docs/rules/server-rules.mdx","fe081ebca2d1fd88","rules/ingame",{"id":49,"data":51,"body":56,"filePath":57,"digest":58,"deferredRender":16},{"title":52,"description":52,"editUrl":16,"head":53,"template":43,"sidebar":54,"pagefind":16,"draft":32},"关于游戏内",[],{"hidden":32,"attrs":55},{},"- 请在游戏内尊重玩家及其劳动成果。\n- 不要随便破坏其他玩家的建筑/机器。在你想找寻某种机器或使用某种不会的机器时，请务必向其他玩家交流和咨询。同时 ，你可以搭配官网的网页地图食用。\n- 如果你不小心破坏了其他玩家的建筑/机器，请务必修复。在已经导致不可修复的错误的情况下，请务必向群内承认并寻求帮助。\n- 设计机器请考虑指引问题和优化问题，帮助其他玩家快速了解使用方法，请勿过度消耗服务器硬件资源。\n- 当你大量需要某种建材时，请友好交流，避免过度消耗服务器资源，更不允许出现抱怨或攻击行为。\n- 请已经熟悉服务器的玩家在允许的情况下，尽可能为新玩家提供引导行为。","src/content/docs/rules/ingame.mdx","e45255862beac476","rules/time",{"id":59,"data":61,"body":66,"filePath":67,"digest":68,"deferredRender":16},{"title":62,"description":62,"editUrl":16,"head":63,"template":43,"sidebar":64,"pagefind":16,"draft":32},"关于活跃度",[],{"hidden":32,"attrs":65},{},"为保证整体活跃度和玩家体验，我们会长期清理服务器活跃度低的玩家，以下情况除外\r\n\r\n- 为服务器做出过巨大贡献的玩家\r\n- 服务器活跃度低，但交流平台活跃度高的玩家\r\n- 管理和维护人员\r\n- 其他特殊人员","src/content/docs/rules/time.mdx","af11079e6f918997","features/server-commands",{"id":69,"data":71,"body":76,"filePath":77,"digest":78,"deferredRender":16},{"title":72,"description":72,"editUrl":16,"head":73,"template":43,"sidebar":74,"pagefind":16,"draft":32},"服务器指令",[],{"hidden":32,"attrs":75},{},"这里列举了作为普通玩家，你可以使用的一些指令\n\n- 使用\"  /getPlayerSkull 名字 数量   \"获取某个玩家的头颅\n- 使用\"    /getsavesize    \"获取服务器存档的大小\n- /seed指令已开放","src/content/docs/features/server-commands.mdx","f808388ab5fc65dd","features/server-recipes",{"id":79,"data":81,"body":86,"filePath":87,"digest":88,"deferredRender":16},{"title":82,"description":82,"editUrl":16,"head":83,"template":43,"sidebar":84,"pagefind":16,"draft":32},"服务器特殊内容",[],{"hidden":32,"attrs":85},{},"在不过于影响原版机制的情况下，我们修改了一些与原版不符的内容\n\n- 末影箱是原版的两倍大小。\n- 服务器有一些特殊成就，用于平时发放周边等。\n- 对于潜影盒、末影箱等，你可以直接拿在手中右键打开。\n- 你可以合成包括鞘翅在内的一些东西，详细配方见 www.lyjdtz.life/chspif","src/content/docs/features/server-recipes.mdx","1340491cc97a1092","other/config",{"id":89,"data":91,"body":97,"filePath":98,"digest":99,"deferredRender":16},{"title":92,"description":93,"editUrl":16,"head":94,"template":43,"sidebar":95,"pagefind":16,"draft":32},"配置","服务器相关配置信息",[],{"hidden":32,"attrs":96},{},"软件配置\n- 每2小时进行一次数据备份，保留最近24次备份。\n- 服务端环境：Async-Fabric BlueMap Carpet-AMS-Addition Carpet-ORG-Addition Carpet-TIS-Addition Fabric-API Fabric-Carpet Fabric-Language-Kotlin Gugle-Carpet-Addition Jade Krypton Ledger Lithium QuickShulker Servux Spark Syncmatica TT20 VMP\n\n硬件配置\n- 9950X+32G内存\n- 30M上行带宽\n- BGP三线网络","src/content/docs/other/config.mdx","efa2faadf6f6a964","other/qa",{"id":100,"data":102,"body":108,"filePath":109,"digest":110,"deferredRender":16},{"title":103,"description":104,"editUrl":16,"head":105,"template":43,"sidebar":106,"pagefind":16,"draft":32},"Q&A","常见问题解答",[],{"hidden":32,"attrs":107},{},"To-do","src/content/docs/other/qa.mdx","523d5a57732c09ec","other/carpet-settings",{"id":111,"data":113,"body":119,"filePath":120,"digest":121,"deferredRender":16},{"title":114,"description":115,"editUrl":16,"head":116,"template":43,"sidebar":117,"pagefind":16,"draft":32},"carpet设置","carpet相关设置的图片展示",[],{"hidden":32,"attrs":118},{},"![图片1](https://img.cdn1.vip/i/69355643278f6_1765103171.webp)\n\n![图片2](https://img.cdn1.vip/i/69355645320ec_1765103173.webp)\n\n![图片3](https://img.cdn1.vip/i/693556474ddde_1765103175.webp)\n\n![图片4](https://img.cdn1.vip/i/693556490ec46_1765103177.webp)\n\n![图片5](https://img.cdn1.vip/i/6935564b198b8_1765103179.webp)","src/content/docs/other/carpet-settings.mdx","d4b96b642815348f","rules/violations",{"id":122,"data":124,"body":130,"filePath":131,"digest":132,"deferredRender":16},{"title":125,"description":126,"editUrl":16,"head":127,"template":43,"sidebar":128,"pagefind":16,"draft":32},"关于违规行为","服务器违规行为的定义和处理",[],{"hidden":32,"attrs":129},{},"如果不确定某种行为是否可能造成违规，请在主群内咨询\n\n包含但不限于以下行为属于违反服务器规定\n\n- 各种意义上的言论不当，各种刷屏等影响玩家正常交流的行为\n- 无意义破坏美观的行为，如擎天柱\n- 使用投影打印机功能\n- 随意破坏其他玩家的劳动成功，以任何形式妨碍其他玩家的正常游戏体验\n- 在既定闯祸的前提下隐瞒不报\n- 在未与服务器机器负责人商讨的情况下私自建设生电类机器\n- 向外泄露服务器内部平台信息/在其他服务器相关页面宣传本服\n- 使用任何外挂类、漏洞类功能\n- 使用/建造机器不考虑可能会导致服务器卡崩的行为","src/content/docs/rules/violations.mdx","bea8d31ffedefc12","rules/redstone-machines",{"id":133,"data":135,"body":141,"filePath":142,"digest":143,"deferredRender":16},{"title":136,"description":137,"editUrl":16,"head":138,"template":43,"sidebar":139,"pagefind":16,"draft":32},"关于生电机器建造","服务器生电机器建造的规定和要求",[],{"hidden":32,"attrs":140},{},"请注意，为方便玩家使用、新人引导以及合理分配服务器硬件，本服生电机器建造有严格的要求，请仔细阅读\n\n- 如果你需要寻找机器的位置，请前往 https://map.chspif.space/\n- 服务器不允许私自在生电区域以外的地方建造任何生电机器，发现会逐步拆除\n- 如果你需要建造任何会引起卡服行为的生电机器，或是需要建造总体量超过5w的建筑，或是需要建造面积超过200*200的建筑，你需要联系OOPZ公告里的其中一位管理和他商讨。你需要告知他大致的建造位置，材料需求和预计完工时间。这样做的原因是建筑的协调性以及防止出现大量消耗服务器资源或形成烂尾。如果你要建造大体量建造，请确保你的建材已经收集完成再开关，大面积的烂尾会被视为破坏美观行为。望理解。\n- 如果你想使用/建造某种机器，请与服务器负责相关工作的人员咨询、商讨和规划，相关人员信息会被列在OOPZ的公告中\n- 请绝对不要轻易使用你不会使用的机器\n- 对于已有的满足产量的既定机器，我们不允许重复建设","src/content/docs/rules/redstone-machines.mdx","b30ed4b12b2de5ab","enter/whitelist",{"id":144,"data":146,"body":151,"filePath":152,"digest":153,"deferredRender":16},{"title":147,"description":147,"editUrl":16,"head":148,"template":43,"sidebar":149,"pagefind":16,"draft":32},"白名单绑定",[],{"hidden":32,"attrs":150},{},"- 在qq群内发送\"  #绑定 你的JavaID   \" 群内会有机器人帮你自动完成绑定\r\n\r\n- 如果你不小心绑错了ID，请使用“#绑定 解绑 QQ号”解除绑定后再重新绑定。","src/content/docs/enter/whitelist.mdx","097efd09c31ac343","enter/download",{"id":154,"data":156,"body":161,"filePath":162,"digest":163,"deferredRender":16},{"title":157,"description":157,"editUrl":16,"head":158,"template":43,"sidebar":159,"pagefind":16,"draft":32},"资源下载",[],{"hidden":32,"attrs":160},{},"服务器无需添加额外模组进入，但我们仍为你提供了一些优化材质和模组\r\n\r\n- 你可以点击[这里](https://chspifvideo.oss-cn-hangzhou.aliyuncs.com/1.12.10_fabric_%E5%AE%A2%E6%88%B7%E7%AB%AF%E7%BA%A2%E7%9F%B3%E6%A8%A1%E7%BB%84_dp495.7z)下载优化模组\r\n- 你可以点击[这里](https://chspifvideo.oss-cn-hangzhou.aliyuncs.com/%E6%9D%90%E8%B4%A8%E4%BC%98%E5%8C%96.7z)下载优化材质","src/content/docs/enter/download.mdx","75f75e8b77f38c30"]